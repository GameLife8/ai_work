# ============= 平台 =============
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123

# Connection 配置和模型 api_key 在 DB 里的对称加密密钥；生产强制配置。
# 生成命令：python scripts/generate_encryption_key.py
# 也可以直接填一段长 passphrase，平台会 sha256 派生为 32 字节 key。
# ⚠️ 丢了这把 key 等于丢全部已加密数据，千万别跟 DB 备份放一起。
PLATFORM_ENCRYPTION_KEY=

# ============= DB（外部 TiDB / MySQL）=============
# 本地无 DB 调试时设 STORE_BACKEND=memory，并清空 DATABASE_URL
STORE_BACKEND=sql
TIDB_HOST=169.24.1.87
TIDB_PORT=4000
TIDB_DATABASE=ai_alert
TIDB_USERNAME=ai_alert
TIDB_PASSWORD=ai_alert
DATABASE_URL=mysql+pymysql://ai_alert:ai_alert@169.24.1.87:4000/ai_alert?charset=utf8mb4

# ============= 模型（火山方舟示例）=============
AI_PROVIDER=volcengine_ark
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_API_KEY=your-ark-api-key
AI_MODEL=ep-xxx-xxxxxx
AI_TIMEOUT_SECONDS=120
USE_STUB_AI=false

# ============= 远端 Swarm 默认接入（可选；后台也能加多份）=============
DOCKER_HOST=tcp://1.2.3.4:2375
DOCKER_BIN=docker
DOCKER_TLS_VERIFY=
DOCKER_CERT_PATH=
DOCKER_LOG_DEFAULT_TAIL=100
DOCKER_LOG_MAX_TAIL=1000

# ============= Zabbix 默认接入（可选）=============
ZABBIX_BASE_URL=http://your-zabbix/zabbix/api_jsonrpc.php
ZABBIX_USERNAME=
ZABBIX_PASSWORD=
ZABBIX_TIMEOUT_SECONDS=10
USE_STUB_ZABBIX=false

# ============= MCP server（可选；不用就不开）=============
MCP_API_KEYS=
MCP_ALLOW_ANON=false

# ============= Agent 行为 =============
AGENT_MAX_REASONING_STEPS=8

# ============= compose 端口（可选覆盖）=============
BACKEND_PORT=5000
CHAT_PORT=8000
ADMIN_PORT=8080
