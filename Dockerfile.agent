# =====================================================================
# ai-ops-agent —— 每个节点上跑的 HTTP 诊断代理容器。
#
# 部署见：
#   - Swarm: deploy/ai-ops-agent-swarm.yml
#   - K8s:   deploy/ai-ops-agent-k8s.yaml
#   - 协议:  docs/host-agent.md
#
# 镜像约 60-80MB，alpine 基础 + iproute2 / iptables / tcpdump / py3-aiohttp 一应俱全。
# =====================================================================
FROM alpine:3.20

ENV TZ=Asia/Shanghai \
    AGENT_PORT=9100 \
    AGENT_AUTH_TOKEN_FILE=/run/secrets/token \
    AGENT_ALLOWED_FILE=/etc/ai-ops-agent/allowed.yml \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# alpine 镜像默认源在国外；启用阿里云镜像加速。私有化部署时 admin 可重写为内网。
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories \
 && apk add --no-cache \
        tzdata \
        # 网络层取证
        iproute2 iptables ip6tables nftables ipvsadm ethtool bridge-utils \
        # 包抓取 + DNS
        tcpdump bind-tools \
        # 进容器 / 内核事件
        util-linux \
        # 文件 / 系统 / 容器排障
        lsof procps coreutils findutils file \
        # curl —— 仅构建期下载 crictl 用(busybox wget 拉镜像源会被 400/503;curl 正常)。
        # 运行时 allowed.yml 没放 curl,集群内 SSRF 边界不变。
        curl \
        # Docker CLI ——只在 AGENT_MODE=docker_proxy 模式下用，调本地 /var/run/docker.sock
        # 起 sibling 容器跑 nsenter。direct 模式装着也不碍事（~20MB）。
        docker-cli \
        # Python + aiohttp + yaml
        python3 py3-aiohttp py3-yaml \
 && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
 && echo "Asia/Shanghai" > /etc/timezone

# crictl —— K8s(containerd)节点拿「容器/Pod → 宿主机 PID」用。alpine 没有 cri-tools 包,
# 装官方静态二进制。crictl 读 CONTAINER_RUNTIME_ENDPOINT 环境变量连 containerd.sock
# (deploy/ai-ops-agent-k8s.yaml 里已设该 env + 挂了 /run/containerd/containerd.sock)。
ARG CRICTL_VERSION=v1.30.0
# github releases 国内直连拉不动(503)。默认走 daocloud 的 github 镜像;
# 私有化/换源用 ``--build-arg CRICTL_MIRROR=<你的镜像基址>`` 覆盖(直连 github 传 https://github.com)。
ARG CRICTL_MIRROR=https://files.m.daocloud.io/github.com
RUN set -eux; \
    arch="$(uname -m)"; case "$arch" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; esac; \
    curl -fsSL -o /tmp/crictl.tgz "${CRICTL_MIRROR}/kubernetes-sigs/cri-tools/releases/download/${CRICTL_VERSION}/crictl-${CRICTL_VERSION}-linux-${arch}.tar.gz"; \
    tar -xzf /tmp/crictl.tgz -C /usr/local/bin crictl; \
    rm /tmp/crictl.tgz; \
    /usr/local/bin/crictl --version

# Agent 主体 + 白名单
COPY agent/agent.py /usr/local/bin/agent.py
COPY agent/allowed.yml /etc/ai-ops-agent/allowed.yml

# 健康检查走未鉴权的 /livez（不带 token，方便 docker/k8s 自己探活）
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:9100/livez || exit 1

EXPOSE 9100

# 用 root + 特权运行——这是设计上要求的（nsenter -t 1 进宿主 namespace）。
# 部署 YAML 里通过 privileged + pid:host 才能真正 nsenter。
ENTRYPOINT ["python3", "/usr/local/bin/agent.py"]
